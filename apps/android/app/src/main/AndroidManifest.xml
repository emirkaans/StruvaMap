<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".StruvaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.StruvaMap"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.StruvaMap.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- struvamap.com paylaşım linklerini (davet, sonuç, kıyaslama)
                 uygulama içinde açar. autoVerify yok — Digital Asset Links
                 doğrulaması (assetlinks.json) production imza sertifikası
                 gerektirir, henüz üretilmedi (bkz. keystore.properties.example).
                 Bu haliyle Android bağlantıya tıklanınca "Chrome/StruvaMap ile
                 aç" seçici gösterir, otomatik açmaz — imza anahtarı üretilince
                 autoVerify="true" + assetlinks.json eklenip sağlamlaştırılabilir. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="struvamap.com" android:pathPrefix="/test" />
                <data android:scheme="https" android:host="struvamap.com" android:pathPrefix="/result" />
                <data android:scheme="https" android:host="struvamap.com" android:pathPrefix="/comparisons" />
            </intent-filter>
        </activity>

        <!-- Nabız bildirimindeki 1-5 düğmeleri (bkz. PulseNotifications). -->
        <receiver
            android:name=".pulse.PulseAnswerReceiver"
            android:exported="false" />

        <!-- Ana ekran "bugünün nabzı" widget'ı (Glance). -->
        <receiver
            android:name=".pulse.widget.PulseWidgetReceiver"
            android:exported="true"
            android:label="Günlük nabız">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pulse_widget_info" />
        </receiver>

        <service
            android:name=".push.FcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
